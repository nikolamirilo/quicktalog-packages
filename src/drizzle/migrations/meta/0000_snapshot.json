      },
      "isExisting": false,
      "definition": "SELECT u.email, u.name, u.plan_id AS price_id, s.subscription_status, s.created_at, s.updated_at, 'https://www.quicktalog.app/catalogues/'::text || COALESCE(c.name, ''::text) AS catalogue_name FROM subscriptions s LEFT JOIN users u ON s.customer_id = u.customer_id LEFT JOIN catalogues c ON c.created_by = u.id WHERE s.subscription_status = 'active'::text AND u.name !~~* '%Mirilo%'::text AND u.name !~~* '%Tes%'::text AND u.name !~~* '%Montre%'::text AND u.name !~~* '%Djuranov%'::text AND u.email !~~* '%test%'::text AND s.scheduled_change IS NULL",
