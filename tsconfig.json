{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    // TypeScript 6 no longer picks up node_modules/@types automatically.
    "types": ["node"]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist"
  ]
}
